    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.0",
    "sass": "^1.85.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.2.0"
  }
}
