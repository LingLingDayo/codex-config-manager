{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codex-config-manager",
  "version": "1.0.0",
  "identifier": "com.codex.configmanager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Codex 配置助手",
        "width": 456,
        "height": 340,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
