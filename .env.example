# ==========================================
# Codex 配置助手 - 环境变量配置文件示例
# 复制此文件为 .env 即可生效自定义配置
# ==========================================

# 默认中转站标识/名称（如未配置，默认使用 LingAI）
VITE_DEFAULT_STATION_NAME=LingAI

# 默认中转站真实 Base URL 地址（如未配置，默认使用 https://lingai.linglingdayo.top）
VITE_DEFAULT_STATION_URL=https://lingai.linglingdayo.top
